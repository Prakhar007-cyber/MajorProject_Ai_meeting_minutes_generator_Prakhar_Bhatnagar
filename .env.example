# Copy this file to ".env" and fill in your keys.

# Hugging Face token (for pyannote speaker diarization)
HF_TOKEN=hf_your_token_here

# Groq API key (for meeting minutes). Leave empty to skip minutes.
GROQ_API_KEY=gsk_your_key_here

# Optional: which Groq model to use
GROQ_MODEL=openai/gpt-oss-120b

# Optional: uncomment after models are downloaded once, to run fully offline
# HF_HUB_OFFLINE=1
